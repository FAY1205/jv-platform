# ─────────────────────────────────────────────────────────────────────────────
# JV Platform — environment template. Copy to .env.local and fill as phases need.
# Non-production (dev/preview) MUST use SEPARATE Supabase projects and an email
# sink — code must never be able to email real partners from dev/preview (SEC-07).
# ─────────────────────────────────────────────────────────────────────────────

# App
# One of: development | preview | production  (drives the env-separation guardrails)
APP_ENV=development
NEXT_PUBLIC_APP_NAME=TerritoryDesk

# Supabase (US region) — provisioned just-in-time (WP-005+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — NEVER expose to the client (SEC-01)
SUPABASE_SERVICE_ROLE_KEY=
# Local dev connection string (Supabase CLI / Docker Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Email (Resend) — non-prod is intercepted to a sink/allowlist (SEC-07)
RESEND_API_KEY=
# In dev/preview, all outbound mail is redirected here instead of the real recipient
EMAIL_SINK_ADDRESS=dev-sink@example.test

# Observability (Sentry, ADR-0032) — the sole activation switch. Leave unset to keep
# dev/preview/CI fully inert (SEC-07): logError stays console-only and the cron monitors
# do nothing. Set to a US-region DSN (ADR-0003 residency) to turn on server-side error
# transport + the ACT-05 job check-ins in that environment.
SENTRY_DSN=

# Auth / security
# Comma-separated allowlist of admin emails permitted to be provisioned (V1: no self-signup)
ADMIN_ALLOWLIST=
