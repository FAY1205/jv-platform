# ─────────────────────────────────────────────────────────────────────────────
# JV Platform — environment template. Copy to .env.local and fill as phases need.
# Non-production (dev/preview) MUST use SEPARATE Supabase projects and an email
# sink — code must never be able to email real partners from dev/preview (SEC-07).
# ─────────────────────────────────────────────────────────────────────────────

# App
# One of: development | preview | production  (drives the env-separation guardrails)
APP_ENV=development
NEXT_PUBLIC_APP_NAME=TerritoryDesk
# Canonical base URL for EVERY link that leaves the system in an email — password-reset,
# signup-verify, team/partner invites, and digest CTAs — whether sent by the release cron or
# by a live request (C-101: never the request Host header, which the caller controls).
# REQUIRED in production — the app refuses to boot if left at the localhost default.
APP_URL=http://localhost:3000

# Supabase (US region) — provisioned just-in-time (WP-005+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — NEVER expose to the client (SEC-01)
SUPABASE_SERVICE_ROLE_KEY=
# Local dev connection string (Supabase CLI / Docker Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Email (Resend) — non-prod is intercepted to a sink/allowlist (SEC-07)
# REQUIRED in production: transactional email (OTP/invite/reset) sends for real via Resend
# only when APP_ENV=production AND this key is set. The app refuses to boot in production
# without it (otherwise partner sign-in codes would be silently black-holed).
RESEND_API_KEY=
# The verified sending identity, e.g. "JV Platform <noreply@yourdomain.com>". REQUIRED in
# production (must be on a domain verified in Resend); boot fails if left at the placeholder.
EMAIL_FROM=
# In dev/preview, all outbound mail is redirected here instead of the real recipient
EMAIL_SINK_ADDRESS=dev-sink@example.test

# Observability (Sentry, ADR-0032) — the sole activation switch. Leave unset to keep
# dev/preview/CI fully inert (SEC-07): logError stays console-only and the cron monitors
# do nothing. Set to a US-region DSN (ADR-0003 residency) to turn on server-side error
# transport + the ACT-05 job check-ins in that environment.
SENTRY_DSN=

# CAPTCHA (Cloudflare Turnstile, ADR-0034)
# Signup bot protection. TURNSTILE_SECRET_KEY and TURNSTILE_SITE_KEY are both REQUIRED in
# production — the app refuses to boot without them (public signup must never ship without
# server-side CAPTCHA verification, and the widget never renders without a site key).
# Dev/preview/CI may use Turnstile's always-pass test keys: site
# 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# ADR-0034: public signup kill-switch. Blank/unset = default (OFF in production, ON
# elsewhere). Set to "true"/"false" to force it explicitly.
SIGNUP_ENABLED=

# Shared secret Vercel Cron presents as `Authorization: Bearer <CRON_SECRET>`. The cron
# routes refuse to run when it is unset, so scheduled digests / retention + signup sweeps
# silently stop without it. MUST be 32+ chars of [A-Za-z0-9_-] and not a UUID, so the log
# scrubber can always redact it (SEC-05). base64 ends in "=", which the check rejects, so:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
CRON_SECRET=

# Auth / security
# Comma-separated allowlist of admin emails permitted to be provisioned (V1: no self-signup)
ADMIN_ALLOWLIST=
